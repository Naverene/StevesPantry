  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Spices from around the world and dishes you assemble yourself, Tinkers' style.\nDishes go stale and spoil, so cook what you'll eat. Pairs with Pam's HarvestCraft 2.",
  "authors": [
    "awweaver"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/stevespantry/textures/item/cinnamon.png",
