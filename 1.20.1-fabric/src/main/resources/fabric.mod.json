  "entrypoints": {
    "main": [
      "com.naverene.stevespantry.StevesPantry"
    ],
    "client": [
      "com.naverene.stevespantry.StevesPantryClient"
    ]
  },
  "mixins": [
    "stevespantry.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=17"
  },
